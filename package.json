{
  "name": "narrated-demo-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate_job.mjs templates/job-manifest.example.json && node scripts/validate_chapters.mjs templates/chapter-manifest.example.json",
    "doctor": "node scripts/toolchain.mjs",
    "ingest": "node scripts/ingest_media.mjs",
    "match-slides": "node scripts/match_slides.mjs",
    "voicebox:start": "node scripts/start_voicebox_server.mjs",
    "install:media:macos": "bash scripts/install_toolchain_macos.sh",
    "install:media:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install_toolchain_windows.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
