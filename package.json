{
  "name": "narrated-deck-studio",
  "version": "0.3.0",
  "private": true,
  "description": "Consent-first local production of reviewed narrated PowerPoints and videos.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-mongan/narrated-deck-studio.git"
  },
  "bugs": {
    "url": "https://github.com/c-mongan/narrated-deck-studio/issues"
  },
  "homepage": "https://github.com/c-mongan/narrated-deck-studio#readme",
  "packageManager": "npm@10.9.8",
  "type": "module",
  "bin": {
    "nds": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/run_node_tests.mjs && node scripts/run_studio_tests.mjs && node scripts/test_world_class_decks.mjs",
    "test:legacy": "node scripts/run_node_tests.mjs",
    "test:studio": "node scripts/run_studio_tests.mjs",
    "test:decks": "node scripts/test_world_class_decks.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run lint && npm test && npm run validate && npm run mcp:build && npm run smoke:mcp",
    "validate": "node scripts/validate_job.mjs templates/job-manifest.example.json && node scripts/validate_chapters.mjs templates/chapter-manifest.example.json",
    "doctor": "node scripts/toolchain.mjs",
    "studio": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "smoke:mcp": "node scripts/smoke_mcp.mjs",
    "mcp:build": "npm run build && node scripts/prepare_mcpb.mjs && mcpb validate mcpb/manifest.json && mcpb pack mcpb dist/narrated-deck-studio.mcpb",
    "hosts:install": "node scripts/install_agent_hosts.mjs",
    "engines:install": "node scripts/install_external_engines.mjs",
    "ingest": "node scripts/ingest_media.mjs",
    "match-slides": "node scripts/match_slides.mjs",
    "voicebox:start": "node scripts/start_voicebox_server.mjs",
    "install:media:macos": "bash scripts/install_toolchain_macos.sh",
    "install:media:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install_toolchain_windows.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/bundler": "^4.0.512",
    "@remotion/player": "^4.0.512",
    "@remotion/renderer": "^4.0.512",
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.512",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
