{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrated-deck.studio/schemas/inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRoot", "scannedAt", "items", "ignored", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "scannedAt": { "type": "string", "format": "date-time" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "ignored": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["relativePath", "reason"], "properties": { "relativePath": { "type": "string" }, "reason": { "type": "string" } } } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "canonicalPath", "kind", "extension", "bytes", "sha256", "summary", "privacy", "warnings"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 }, "canonicalPath": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["powerpoint", "document", "text", "audio", "video", "image", "data"] }, "extension": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "summary": { "type": "string" },
        "notesPresent": { "type": "boolean" }, "slideCount": { "type": "integer", "minimum": 0 }, "durationSeconds": { "type": "number", "minimum": 0 },
        "privacy": { "enum": ["normal", "sensitive"] }, "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
