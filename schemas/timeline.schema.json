{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrated-deck.studio/schemas/timeline.schema.json",
  "title": "Narrated Deck Studio timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "itemId", "audioMaster", "audioSha256", "slides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "audioMaster": { "type": "string", "minLength": 1 },
    "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide", "start", "end", "narration", "confidence", "reviewRequired"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "narration": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reviewRequired": { "type": "boolean" },
          "transition": { "enum": ["cut", "fade", "dissolve"] }
        }
      }
    }
  }
}
